# Copy this to .env and adjust as needed
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3:instruct
VISION_MODEL=llava
EMBED_MODEL=nomic-embed-text
DATA_DIR=/app/data/pdfs
CHROMA_DIR=/app/data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=8
RERANK_ENABLED=true
RERANK_CANDIDATES=20
FIGURE_DETECTION_ENABLED=false
