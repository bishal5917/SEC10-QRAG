# ============================================================
# Multimodal RAG - Environment Variables
# ============================================================

# Google Gemini API Key (required)
# At: https://aistudio.google.com/apikey
GEMINI_API_KEY=gemini_api_key_here

# HuggingFace Hub Token (optional)
# Removes anonymous-download warnings and raises download rate limits.
# At: https://huggingface.co/settings/tokens (read access)
HF_TOKEN=hf_token_here
# Langfuse observability (optional; only needed if enable_langfuse=True in config)
# Get these from the local Langfuse UI (localhost:3000) → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
